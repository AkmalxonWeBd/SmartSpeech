# Web build natijalari
dist/
web-build/

# Lokal server fayllari — bu serverda ishlaydi, APK ichida emas
server/

# IDE / Editor
.vscode/
.idea/

# Expo cache
.expo/

# Debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store

# Sertifikatlar
*.pem
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Typescript build info
*.tsbuildinfo

